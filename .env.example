# Sierra Safety Index — Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.

# GCP
GCP_PROJECT_ID=your-project-id-here
GCP_REGION=us-central1
GCS_RAW_BUCKET=sierra-safety-raw-your-project-id
GCS_PROCESSED_BUCKET=sierra-safety-processed-your-project-id
BIGQUERY_DATASET=sierra_safety
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Kafka (local Docker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=sierra.road.events
SCHEMA_REGISTRY_URL=http://localhost:8081

# Pipeline config
POLL_INTERVAL_SECONDS=300
DRY_RUN=false          # set true to use fixture files instead of live HTTP

# Debug options
DEBUG_SINK=bigquery    # options: bigquery | console | local_parquet
USE_GCP=true # set to false to disable GCP interactions (useful for local testing without GCP credentials)
